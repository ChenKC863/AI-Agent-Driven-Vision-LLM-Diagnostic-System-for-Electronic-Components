# Generated JSONL fine-tuning datasets
electronics_train_*.jsonl
electronics_validation_*.jsonl
electronics_test_*.jsonl

# QLoRA / PEFT / GGUF model artifacts
# Keep code and small configuration files in GitHub, but do not commit weights.
